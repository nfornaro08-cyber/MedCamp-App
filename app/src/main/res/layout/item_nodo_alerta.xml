<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardNodoAlerta"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/bg_card_dark"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/border_medium"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingTop="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="12dp">

            <FrameLayout
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_circle_icon"
                android:layout_marginEnd="10dp">

                <ImageView
                    android:id="@+id/imgIconoNodo"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="Nodo"
                    android:src="@drawable/ic_layers"
                    app:tint="@color/green_neon" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvNombreNodo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NODO"
                    android:textColor="@color/text_pure_white"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSubtituloNodo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1 variable fuera de rango"
                    android:textColor="@color/text_muted_gray"
                    android:textSize="11sp"
                    android:maxLines="2"
                    android:ellipsize="end" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvBadgeNodo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_badge_danger"
                android:paddingHorizontal="9dp"
                android:paddingVertical="4dp"
                android:text="1 ALERTA"
                android:textColor="@color/danger_red"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginHorizontal="14dp"
            android:background="@color/border_subtle" />

        <LinearLayout
            android:id="@+id/llVariablesNodo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="14dp"
            android:paddingBottom="6dp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
