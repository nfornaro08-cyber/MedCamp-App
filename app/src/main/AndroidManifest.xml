<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Solo necesario en Android 9 o menos para escribir el Excel en Descargas -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="MedCamp"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MedCamp"
        android:usesCleartextTraffic="true">

        <!-- 1. Inicio: resumen general (pantalla de entrada) -->
        <activity
            android:name=".InicioActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".LoginActivity"
            android:exported="false" />

        <!-- 2. Panel Principal: telemetría en vivo (secundario) -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <!-- 3. Alta de nodos: nombre + descripción -->
        <activity
            android:name=".AgregarNodoActivity"
            android:exported="false" />

        <activity
            android:name=".DetalleGraficoActivity"
            android:exported="false" />

        <activity
            android:name=".HistorialActivity"
            android:exported="false" />

    </application>

</manifest>
